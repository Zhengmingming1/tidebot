#!/usr/bin/env bash
# Fake Claude Code CLI for tidebot Phase-0 tests.
# Emits stream-json NDJSON to stdout; respects -p prompt and env for provider checks.
set -euo pipefail

PROMPT=""
OUTPUT_FORMAT=""
VERBOSE=0
BARE=0
ARGS=("$@")
i=0
while [[ $i -lt $# ]]; do
  a="${ARGS[$i]}"
  case "$a" in
    -p)
      i=$((i+1))
      PROMPT="${ARGS[$i]:-}"
      ;;
    --output-format)
      i=$((i+1))
      OUTPUT_FORMAT="${ARGS[$i]:-}"
      ;;
    --verbose) VERBOSE=1 ;;
    --bare) BARE=1 ;;
    --version)
      echo "mock-claude 0.1.0 (tidebot)"
      exit 0
      ;;
    --fail)
      echo '{"type":"result","subtype":"error","is_error":true,"result":"mock failure","session_id":"sess_fail","total_cost_usd":0,"usage":{"input_tokens":1,"output_tokens":0}}'
      exit 2
      ;;
    --sleep)
      i=$((i+1))
      sleep "${ARGS[$i]:-2}"
      ;;
  esac
  i=$((i+1))
done

if [[ -n "${TIDEBOT_MOCK_ARGS_FILE:-}" ]]; then
  printf '%s\n' "$@" > "$TIDEBOT_MOCK_ARGS_FILE"
fi
if [[ -n "${TIDEBOT_MOCK_WRITE_FILE:-}" ]]; then
  printf 'mock edit\n' > "$TIDEBOT_MOCK_WRITE_FILE"
fi
if [[ -n "${TIDEBOT_MOCK_ENV_FILE:-}" ]]; then
  env | grep -E '^(CLAUDE_CONFIG_DIR|HOME|CLAUDE_CODE_OAUTH_TOKEN)=' > "$TIDEBOT_MOCK_ENV_FILE" || true
fi
if [[ -n "${TIDEBOT_MOCK_FAIL_MSG:-}" ]]; then
  if [[ -z "${TIDEBOT_MOCK_FAIL_COUNTER:-}" ]] || [[ "$(cat "$TIDEBOT_MOCK_FAIL_COUNTER" 2>/dev/null || echo 0)" -gt 0 ]]; then
    [[ -n "${TIDEBOT_MOCK_FAIL_COUNTER:-}" ]] && echo $(( $(cat "$TIDEBOT_MOCK_FAIL_COUNTER") - 1 )) > "$TIDEBOT_MOCK_FAIL_COUNTER"
    echo "{\"type\":\"result\",\"subtype\":\"error\",\"is_error\":true,\"result\":\"$TIDEBOT_MOCK_FAIL_MSG\",\"session_id\":\"sess_fail\",\"total_cost_usd\":0,\"usage\":{\"input_tokens\":1,\"output_tokens\":0}}"
    exit 1
  fi
fi

if [[ "$OUTPUT_FORMAT" != "stream-json" ]]; then
  echo "mock-claude: expected --output-format stream-json" >&2
  exit 1
fi

SESSION="sess_mock_$$"
MODEL="${ANTHROPIC_MODEL:-mock-model}"
BASE="${ANTHROPIC_BASE_URL:-}"

# system/init
printf '%s\n' "{\"type\":\"system\",\"subtype\":\"init\",\"cwd\":\"$(pwd)\",\"session_id\":\"$SESSION\",\"model\":\"$MODEL\",\"tools\":[\"Bash\",\"Read\"],\"mcp_servers\":[],\"plugin_errors\":[],\"mcp_server_errors\":[]}"

# assistant message (simplified)
PROMPT_JSON=$(printf '%s' "$PROMPT" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))' 2>/dev/null || printf '"%s"' "${PROMPT//\"/\\\"}")
printf '%s\n' "{\"type\":\"assistant\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"echo: \"}]},\"session_id\":\"$SESSION\"}"

# Reflect provider env (no secrets) via a tiny stderr note for debugging in tests
if [[ -n "${TIDEBOT_MOCK_ECHO_ENV:-}" ]]; then
  echo "mock base_url=$BASE model=$MODEL bare=$BARE" >&2
fi

# Optional demo streaming: TIDEBOT_MOCK_STEPS=N emits N progress events, sleeping
# TIDEBOT_MOCK_STEP_SLEEP seconds between them (used for WebUI live-log demos).
STEPS="${TIDEBOT_MOCK_STEPS:-0}"
for ((s=1; s<=STEPS; s++)); do
  sleep "${TIDEBOT_MOCK_STEP_SLEEP:-0.5}"
  if (( s % 2 == 1 )); then
    printf '%s\n' "{\"type\":\"assistant\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"name\":\"Bash\",\"input\":{\"command\":\"step $s of $STEPS\"}}]},\"session_id\":\"$SESSION\"}"
  else
    # TIDEBOT_MOCK_STEP_USAGE=1: each finished step is one priced request (live usage demos/tests).
    USAGE=""
    if [[ "${TIDEBOT_MOCK_STEP_USAGE:-}" == "1" ]]; then
      USAGE=",\"id\":\"msg_${SESSION}_$s\",\"model\":\"$MODEL\",\"usage\":{\"input_tokens\":1200,\"output_tokens\":300,\"cache_read_input_tokens\":0,\"cache_creation_input_tokens\":0}"
    fi
    printf '%s\n' "{\"type\":\"assistant\",\"message\":{\"role\":\"assistant\"$USAGE,\"content\":[{\"type\":\"text\",\"text\":\"Finished step $s of $STEPS\"}]},\"session_id\":\"$SESSION\"}"
  fi
done

# AI plugin builder: spec / build / iterate prompts are answered by plugin_ai.py.
AI_MODE=""
case "$PROMPT" in
  TIDEBOT-PLUGIN-SPEC*) AI_MODE=spec ;;
  TIDEBOT-PLUGIN-BUILD*) AI_MODE=build ;;
  TIDEBOT-PLUGIN-ITERATE*) AI_MODE=iterate ;;
esac
if [[ -n "$AI_MODE" ]]; then
  HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if [[ "$AI_MODE" != spec ]]; then
    for f in plugin.yaml main.py README.md; do
      sleep "${TIDEBOT_MOCK_AI_SLEEP:-0}"
      printf '%s\n' "{\"type\":\"assistant\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"name\":\"Write\",\"input\":{\"file_path\":\"$f\"}}]},\"session_id\":\"$SESSION\"}"
    done
  fi
  OUT=$(printf '%s' "$PROMPT" | python3 "$HERE/plugin_ai.py" "$AI_MODE")
  OUT_JSON=$(printf '%s' "$OUT" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))')
  printf '%s\n' "{\"type\":\"result\",\"subtype\":\"success\",\"result\":$OUT_JSON,\"session_id\":\"$SESSION\",\"is_error\":false,\"duration_ms\":42,\"num_turns\":3,\"total_cost_usd\":0.0123,\"usage\":{\"input_tokens\":900,\"output_tokens\":400}}"
  exit 0
fi

COST="${TIDEBOT_MOCK_COST:-0.00123}"
if [[ "${TIDEBOT_MOCK_RANDOM_COST:-}" == "1" ]]; then
  COST=$(awk -v s="$$" 'BEGIN{srand(s); printf "%.4f", 0.02 + rand()*0.27}')
  IN_TOK_R=$(awk -v s="$$" 'BEGIN{srand(s+1); printf "%d", 800 + rand()*9000}')
fi
IN_TOK=${IN_TOK_R:-12}
OUT_TOK=34
# Optional: fail if no auth when TIDEBOT_MOCK_REQUIRE_AUTH=1
if [[ "${TIDEBOT_MOCK_REQUIRE_AUTH:-}" == "1" ]]; then
  if [[ -z "${ANTHROPIC_AUTH_TOKEN:-}" && -z "${ANTHROPIC_API_KEY:-}" ]]; then
    printf '%s\n' "{\"type\":\"result\",\"subtype\":\"error\",\"is_error\":true,\"result\":\"missing auth\",\"session_id\":\"$SESSION\",\"total_cost_usd\":0,\"duration_ms\":5,\"usage\":{\"input_tokens\":0,\"output_tokens\":0}}"
    exit 1
  fi
fi

printf '%s\n' "{\"type\":\"result\",\"subtype\":\"success\",\"result\":\"ok: ${PROMPT//$'\n'/ }\",\"session_id\":\"$SESSION\",\"is_error\":false,\"duration_ms\":42,\"duration_api_ms\":30,\"num_turns\":1,\"total_cost_usd\":$COST,\"usage\":{\"input_tokens\":$IN_TOK,\"output_tokens\":$OUT_TOK,\"cache_read_input_tokens\":0,\"cache_creation_input_tokens\":0}}"
exit 0
